{
  "name": "wellness-2-pro",
  "version": "2.0.0",
  "private": true,
  "description": "Wellness 2.0 Pro - Capacitor iOS wrapper",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "cap:add:ios": "npm run build:web && npx cap add ios",
