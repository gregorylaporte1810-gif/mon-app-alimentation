  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "@capgo/capacitor-updater": "^8.51.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0"
  },
  "engines": {
    "node": ">=22"
  }
}
